prefix=/Users/newlink/android-sdk/ndk/26.1.10909125/toolchains/llvm/prebuilt/darwin-x86_64/bin
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="HTTP HTTPS"
supported_features="alt-svc AsynchDNS HSTS HTTPS-proxy IPv6 Largefile libz SSL threadsafe UnixSockets"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.20.0-DEV
Requires: zlib
Requires.private: zlib
Libs: -L${libdir} -lcurl -lmbedtls -lmbedx509 -lmbedcrypto -lz -l-pthread
Libs.private: -L/Users/newlink/kemi/stk-code/android/deps-armeabi-v7a/mbedtls/library -L/Users/newlink/kemi/stk-code/android/deps-armeabi-v7a/zlib -lmbedtls -lmbedx509 -lmbedcrypto -lz -l-pthread
Cflags: -I${includedir} -DCURL_STATICLIB
Cflags.private: -DCURL_STATICLIB
